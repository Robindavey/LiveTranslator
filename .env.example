# LiveTranslator environment variables
APP_NAME=LiveTranslator
HOST=0.0.0.0
PORT=8000
MODEL_NAME=small
MODEL_PATH=
USE_WHISPER_CPP=false
WHISPER_LANGUAGE=auto
BEAM_SIZE=5
CHUNK_SIZE_SECONDS=4.0
SAMPLE_RATE=16000
VAD_THRESHOLD=0.5
VAD_WINDOW_SECONDS=0.4
ENABLE_MIC_CAPTURE=true
TRANSLATION_PROVIDER=local
LOCAL_TRANSLATION_MODEL_PATH=
ENABLE_TTS=false
TTS_PROVIDER=piper
MAX_WEBSOCKET_CLIENTS=12
LOG_LEVEL=INFO
